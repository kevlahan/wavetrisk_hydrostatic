spec_type       latlon       ! "sphere" or "latlon"
test_case       climate      ! test case
physics_type    Simple       ! needed for climate test case
Nsoil           10           ! needed for Simple physics model
run_id          SimpleJ7Z30  ! run
cp_beg	        346          ! first checkpoint to analyze
cp_end	        365          ! last  checkpoint to analyze	
max_level	7            ! maximum level of resolution
zlevels         30           ! number of vertical levels
level_save      7            ! resolution level to interpolate to
N               512          ! resolution of interpolated grid (N/2 latitude x N longitude), N  <= sqrt(20*4^J)
local_spec      F            ! compute local power spectrum
lat0            0.0          ! latitude (in degrees) of local region
lon0            0.0          ! longitude (in degrees) of local region	
theta0          20           ! angular radius of spherical region for local spectrum
concentration   0.99         ! percentage of total energy in local region
ntaper          6            ! number of tapers (windows) to use in spectrum estimate (use all tapers with concentration close to desired value)
angular_order   2            ! angular order used to estimate spherical bandwidth for tapers (windows)
